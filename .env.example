# docker-compose.yml 의 PostgreSQL 계정. 복사해서 .env 로 쓴다.
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag

# Qdrant — 비우면 로컬 Docker(http://localhost:6333, gRPC 6334)
# Qdrant Cloud 는 이 두 줄을 .env.cloud 에 채우고 uv run --env-file .env.cloud ... 로 실행한다 (.env* 는 git 제외)
# QDRANT_URL=https://<클러스터 id>.<리전>.cloud.qdrant.io:6333
# QDRANT_API_KEY=
# QDRANT_GRPC=1        # 0 이면 REST
# QDRANT_TIMEOUT=60    # 초. 비우면 5초
